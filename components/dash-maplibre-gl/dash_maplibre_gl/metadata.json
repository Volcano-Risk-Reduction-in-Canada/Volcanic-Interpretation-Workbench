    "props": {
      "id": {
        "type": {
          "name": "string"
        },
        "required": false,
        "description": "The ID used to identify this component in Dash callbacks."
      },
      "initialViewState": {
        "type": {
          "name": "shape",
          "value": {
            "longitude": {
              "name": "number",
              "required": false
            },
            "latitude": {
              "name": "number",
              "required": false
            },
            "zoom": {
              "name": "number",
              "required": false
            },
            "pitch": {
              "name": "number",
              "required": false
            },
            "bearing": {
              "name": "number",
              "required": false
            }
          }
        },
        "required": false,
        "description": "Camera at construction time: {longitude, latitude, zoom, pitch,\nbearing}. Pitch/bearing default to 0 so the map starts flat/top-down\nlike a 2D map; the user can then drag to tilt and rotate in 3D.",
        "defaultValue": {
          "value": "{\n    longitude: -123.6, latitude: 54.64, zoom: 6, pitch: 0, bearing: 0,\n}",
          "computed": false
        }
      },
      "flyTo": {
        "type": {
          "name": "shape",
          "value": {
            "longitude": {
              "name": "number",
              "required": false
            },
            "latitude": {
              "name": "number",
              "required": false
            },
            "zoom": {
              "name": "number",
              "required": false
            },
            "duration": {
              "name": "number",
              "required": false
            }
          }
        },
        "required": false,
        "description": "Write-only camera animation trigger: {longitude, latitude, zoom,\nduration}. Set a new object to fly the camera, mirroring Leaflet's\nflyTo transition.",
        "defaultValue": {
          "value": "null",
          "computed": false
        }
      },
      "basemaps": {
        "type": {
          "name": "objectOf",
          "value": {
            "name": "shape",
            "value": {
              "url": {
                "name": "string",
                "required": false
              },
              "attribution": {
                "name": "string",
                "required": false
              },
              "tileSize": {
                "name": "number",
                "required": false
              },
              "maxzoom": {
                "name": "number",
                "required": false
              },
              "hillshade": {
                "name": "bool",
                "required": false
              },
              "baseKey": {
                "name": "string",
                "required": false
              }
            }
          }
        },
        "required": false,
        "description": "Map of basemap id -> {url, attribution, tileSize, maxzoom} for a\nnormal raster basemap entry, or {label, hillshade: true, baseKey} for\na virtual entry that reuses another basemap's tiles (baseKey) with a\nhillshade layer draped on top instead of fetching tiles of its own.\nEach normal entry becomes a raster source/layer; visibility is\ntoggled by activeBasemap instead of swapping the whole style.\nmaxzoom (optional) is the deepest zoom the provider has tiles for.",
        "defaultValue": {
          "value": "{}",
          "computed": false
        }
      },
      "activeBasemap": {
        "type": {
          "name": "string"
        },
        "required": false,
        "description": "Key into `basemaps` for the currently visible basemap layer.",
        "defaultValue": {
          "value": "null",
          "computed": false
        }
      },
      "basemapMonochrome": {
        "type": {
          "name": "bool"
        },
        "required": false,
        "description": "Desaturate the currently-active basemap raster layer(s) to grayscale\n(uses MapLibre's raster-saturation paint property).",
        "defaultValue": {
          "value": "false",
          "computed": false
        }
      },
      "interferogramTileUrl": {
        "type": {
          "name": "string"
        },
        "required": false,
        "description": "XYZ tile URL template ({x}/{y}/{z}) for the interferogram raster\noverlay, fetched TMS-scheme from the existing /getTileUrl proxy.",
        "defaultValue": {
          "value": "null",
          "computed": false
        }
      },
      "interferogramOpacity": {
        "type": {
          "name": "number"
        },
        "required": false,
        "description": "Opacity of the interferogram raster layer.",
        "defaultValue": {
          "value": "0.85",
          "computed": false
        }
      },
      "interferogramVisible": {
        "type": {
          "name": "bool"
        },
        "required": false,
        "description": "Show/hide the interferogram raster layer (hidden layers stop\nfetching tiles).",
        "defaultValue": {
          "value": "true",
          "computed": false
        }
      },
      "pointSource": {
        "type": {
          "name": "shape",
          "value": {
            "url": {
              "name": "string",
              "required": false
            },
            "bounds": {
              "name": "arrayOf",
              "value": {
                "name": "number"
              },
              "required": false
            },
            "minzoom": {
              "name": "number",
              "required": false
            },
            "maxzoom": {
              "name": "number",
              "required": false
            }
          }
        },
        "required": false,
        "description": "Point-target vector tiles for the Timeseries tab: {url, bounds,\nminzoom, maxzoom}. url is an XYZ template ({x}/{y}/{z}) served\nTMS-scheme by the /getPointTile route; each feature's id is the\nGeoPackage fid. Null removes the points layer.",
        "defaultValue": {
          "value": "null",
          "computed": false
        }
      },
      "pointStyle": {
        "type": {
          "name": "shape",
          "value": {
            "property": {
              "name": "string",
              "required": false
            },
            "min": {
              "name": "number",
              "required": false
            },
            "max": {
              "name": "number",
              "required": false
            },
            "stops": {
              "name": "arrayOf",
              "value": {
                "name": "array"
              },
              "required": false
            }
          }
        },
        "required": false,
        "description": "Point colouring: {property, min, max, stops}. property is the tile\nattribute to colour by; stops is a list of [position, colour] with\nposition from -1 (min) through 0 (pinned to 0 when the range spans\nzero) to 1 (max).",
        "defaultValue": {
          "value": "{\n    property: 'rate',\n    min: -25,\n    max: 25,\n    stops: [[-1, '#d7191c'], [0, '#ffffbf'], [1, '#2b83ba']],\n}",
          "computed": false
        }
      },
      "clickedPoint": {
        "type": {
          "name": "shape",
          "value": {
            "fid": {
              "name": "number",
              "required": false
            },
            "longitude": {
              "name": "number",
              "required": false
            },
            "latitude": {
              "name": "number",
              "required": false
            },
            "timestamp": {
              "name": "number",
              "required": false
            }
          }
        },
        "required": false,
        "description": "Read-only: the point nearest the user's last click on the points\nlayer, {fid, longitude, latitude, timestamp}.",
        "defaultValue": {
          "value": "null",
          "computed": false
        }
      },
      "demTiles": {
        "type": {
          "name": "union",
          "value": [
            {
              "name": "string"
            },
            {
              "name": "arrayOf",
              "value": {
                "name": "string"
              }
            }
          ]
        },
        "required": false,
        "description": "Raster-DEM tile URL template(s) (Mapbox terrain-RGB encoding) used to\ndisplace the terrain surface. Null disables terrain.",
        "defaultValue": {
          "value": "null",
          "computed": false
        }
      },
      "demEncoding": {
        "type": {
          "name": "enum",
          "value": [
            {
              "value": "'terrarium'",
              "computed": false
            },
            {
              "value": "'mapbox'",
              "computed": false
            }
          ]
        },
        "required": false,
        "description": "Encoding used by the raster-DEM tiles: 'terrarium' (e.g. AWS Open\nData's elevation-tiles-prod) or 'mapbox' (Mapbox Terrain-RGB).",
        "defaultValue": {
          "value": "'mapbox'",
          "computed": false
        }
      },
      "terrainExaggeration": {
        "type": {
          "name": "number"
        },
        "required": false,
        "description": "Vertical exaggeration factor applied to the DEM terrain.",
        "defaultValue": {
          "value": "1.5",
          "computed": false
        }
      },
      "earthquakeData": {
        "type": {
          "name": "object"
        },
        "required": false,
        "description": "GeoJSON FeatureCollection of earthquake epicenters; each feature's\nproperties should include magnitude, quakeColour, time, depthKm,\neventId.",
        "defaultValue": {
          "value": "{type: 'FeatureCollection', features: []}",
          "computed": false
        }
      },
      "wmsOverlay": {
        "type": {
          "name": "shape",
          "value": {
            "url": {
              "name": "string",
              "required": false
            },
            "layers": {
              "name": "string",
              "required": false
            },
            "styles": {
              "name": "string",
              "required": false
            },
            "format": {
              "name": "string",
              "required": false
            },
            "opacity": {
              "name": "number",
              "required": false
            },
            "visible": {
              "name": "bool",
              "required": false
            }
          }
        },
        "required": false,
        "description": "Optional WMS raster overlay (e.g. glacier footprints): {url, layers,\nstyles, format, opacity, visible}.",
        "defaultValue": {
          "value": "null",
          "computed": false
        }
      },
      "style": {
        "type": {
          "name": "object"
        },
        "required": false,
        "description": "CSS style applied to the map container div.",
        "defaultValue": {
          "value": "{}",
          "computed": false
        }
      },
      "className": {
        "type": {
          "name": "string"
        },
        "required": false,
        "description": "CSS class applied to the map container div.",
        "defaultValue": {
          "value": "''",
          "computed": false
        }
      }
    }
  }
}